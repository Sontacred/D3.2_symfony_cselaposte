{% extends 'base.html.twig' %}

{% block titre %}Liste des Sites{% endblock %}

{% block content %}
<h1>Liste des sites et salariés</h1>

{% for site in sites %}

    <h2>{{ site.nomSite }}</h2>

    <ul>
        {% for salarie in site.salaries %}
            <li>
                {{ salarie.prenomSal }} {{ salarie.nomSal }}
            </li>
        {% else %}
            <li>Aucun salarié</li>
        {% endfor %}
    </ul>

{% endfor %}

{% endblock %}